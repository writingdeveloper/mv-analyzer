{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mv-analyzer.writingdeveloper.blog/schemas/reason-document-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","kind","policy_id","generated_at","video","source_report","summary","claims","limits"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "mv-analyzer-reason"},
    "policy_id": {"type":"string","minLength":1},
    "generated_at": {"type":"string","minLength":1},
    "video": {
      "type":"object","additionalProperties":false,
      "required":["video_id","title","channel"],
      "properties": {
        "video_id":{"type":"string","minLength":1},
        "title":{"type":"string","minLength":1},
        "channel":{"type":"string","minLength":1}
      }
    },
    "source_report": {
      "type":"object","additionalProperties":false,
      "required":["schema_version","source_features_sha256","corpus_sha256","benchmark_domain"],
      "properties": {
        "schema_version":{"const":2},
        "source_features_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "corpus_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "benchmark_domain":{"enum":["all","vocaloid","kpop"]}
      }
    },
    "summary": {
      "type":"object","additionalProperties":false,
      "required":["distinctive","feel","taste"],
      "properties": {
        "distinctive":{"type":"array","items":{"type":"string"},"uniqueItems":true,"maxItems":4},
        "feel":{"type":"array","items":{"type":"string"},"uniqueItems":true,"maxItems":4},
        "taste":{"type":"array","items":{"type":"string"},"uniqueItems":true,"maxItems":6}
      }
    },
    "claims": {
      "type":"array","maxItems":40,
      "items": {
        "type":"object","additionalProperties":false,
        "required":["id","question","claim_type","subject","direction","support","confidence","scope","text_key","evidence"],
        "properties": {
          "id":{"type":"string","minLength":1},
          "question":{"enum":["distinctive","feel","taste"]},
          "claim_type":{"type":"string","minLength":1},
          "subject":{"type":"string","minLength":1},
          "direction":{"enum":["high","low","mixed","match","none"]},
          "support":{"enum":["supported","contradicted","insufficient"]},
          "confidence":{"enum":["high","medium","low"]},
          "scope":{"enum":["reference_corpus","taste_profile","timeline","measurement_quality"]},
          "text_key":{"type":"string","minLength":1},
          "evidence":{"type":"array","minItems":1,"maxItems":8,"items":{"type":"object"}}
        }
      }
    },
    "limits":{"type":"array","maxItems":20,"items":{"type":"string"}}
  }
}
